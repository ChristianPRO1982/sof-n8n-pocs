      "name": "WH-upload",
      "webhookId": "932587ed-13b4-411e-a921-0fa350960275"
    },
    {
      "parameters": {
        "path": "cdd96ce6-6bdf-44e9-9594-a60a67227141",
        "responseMode": "responseNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        -272,
        -384
      ],
      "id": "1402eb5d-0541-45f7-9e2e-b440f3ba6bf1",
      "name": "WH-list",
      "webhookId": "cdd96ce6-6bdf-44e9-9594-a60a67227141"
    },
    {
      "parameters": {
        "command": "=\nnode <<'JS'\nconst fs = require('node:fs');\nconst path = require('node:path');\n\nconst root = '/files/km';\n\nconst folders = [\n  '01_upload_raw_files',\n  '01_upload_legacy_files'\n];\n\nconst files = folders.flatMap(folder => {\n  const directory = path.join(root, folder);\n\n  return fs.readdirSync(directory, { withFileTypes: true })\n    .filter(entry => entry.isFile())\n    .map(entry => {\n      const stat = fs.statSync(path.join(directory, entry.name), {\n        bigint: true\n      });\n\n      const size = Number(stat.size);\n\n      if (!Number.isSafeInteger(size)) {\n        throw new Error(`Invalid file size: ${entry.name}`);\n      }\n\n      return {\n        folder,\n        name: entry.name,\n        size,\n        revision: [\n          stat.dev,\n          stat.ino,\n          stat.size,\n          stat.mtimeNs,\n          stat.ctimeNs\n        ].join(':')\n      };\n    });\n});\n\nfiles.sort((a, b) =>\n  a.folder.localeCompare(b.folder) ||\n  a.name.localeCompare(b.name)\n);\n\nprocess.stdout.write(JSON.stringify(files));\nJS\n"
      },
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        -48,
        -384
      ],
      "id": "fa7b7791-c244-4b9f-9b87-e1b3f207a2ac",
      "name": "CMD $ls"
    },
    {
      "parameters": {
        "jsCode": "\nconst { exitCode, stderr, stdout } = $input.first().json;\n\nconst allowedFolders = new Set([\n  '01_upload_raw_files',\n  '01_upload_legacy_files'\n]);\n\ntry {\n  if (exitCode !== 0) {\n    throw new Error(stderr?.trim() || 'Impossible de lire les dossiers.');\n  }\n\n  const files = JSON.parse(stdout);\n  const uniqueFiles = new Set();\n\n  if (!Array.isArray(files)) {\n    throw new Error('La réponse doit contenir une liste de fichiers.');\n  }\n\n  for (const file of files) {\n    if (\n      !file ||\n      typeof file.folder !== 'string' ||\n      !allowedFolders.has(file.folder) ||\n      typeof file.name !== 'string' ||\n      file.name.length === 0 ||\n      !Number.isSafeInteger(file.size) ||\n      file.size < 0 ||\n      typeof file.revision !== 'string' ||\n      file.revision.length === 0\n    ) {\n      throw new Error('Liste de fichiers invalide.');\n    }\n\n    const uniqueKey = JSON.stringify([file.folder, file.name]);\n\n    if (uniqueFiles.has(uniqueKey)) {\n      throw new Error(`Fichier en doublon : ${file.folder}/${file.name}`);\n    }\n\n    uniqueFiles.add(uniqueKey);\n  }\n\n  return [\n    {\n      json: {\n        ok: true,\n        files\n      }\n    }\n  ];\n\n} catch (error) {\n  return [\n    {\n      json: {\n        ok: false,\n        message: error.message\n      }\n    }\n  ];\n}\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        176,
        -384
      ],
      "id": "eb4d1d43-283f-476e-abc4-3139a01d3d68",
