      "id": "c367dd8c-604a-4e58-a688-8046298affd0",
      "name": "Extract template"
    },
    {
      "parameters": {
        "jsCode": "\nconst template = $('Extract template').first().json.template.text\nconst document = $('Extract doc').first().json.doc.text\n\nconst normalize = (text) => String(text)\n  .normalize('NFD')\n  .replace(/[\\u0300-\\u036f]/g, '')\n  .trim()\n  .toLowerCase()\n  .replace(/\\s+/g, ' ');\n\nconst getLabel = (line) => {\n  const match = line.match(/^([^:]+?)\\s*:\\s*(.*)$/);\n  return match\n    ? { name: normalize(match[1]), value: match[2] }\n    : null;\n};\n\nconst getSections = (markdown) => {\n  const sections = {};\n  let current = '_root';\n\n  for (const line of markdown.split(/\\r?\\n/)) {\n    const heading = line.match(/^(#{1,6})\\s+(.+?)\\s*$/);\n\n    if (heading) {\n      current = `${heading[1].length}:${normalize(heading[2])}`;\n      sections[current] = [];\n    } else {\n      (sections[current] ??= []).push(line);\n    }\n  }\n\n  return sections;\n};\n\nconst templateSections = getSections(template);\nconst documentSections = getSections(document);\n\nconst expectedSections = Object.keys(templateSections)\n  .filter(key => key !== '_root');\n\nconst missingSections = expectedSections\n  .filter(key => !(key in documentSections));\n\nlet expectedFields = 0;\nlet presentFields = 0;\nlet filledFields = 0;\n\nconst missingFields = [];\nconst unfilledFields = [];\n\nfor (const section of expectedSections) {\n  const sourceLines = templateSections[section];\n  const documentLines = documentSections[section] ?? [];\n\n  const allLabels = new Set(\n    sourceLines.map(getLabel).filter(Boolean).map(f => f.name)\n  );\n\n  const fields = sourceLines\n    .map(getLabel)\n    .filter(f => f && /\\[[^\\]]*renseigner[^\\]]*\\]/.test(normalize(f.value)));\n\n  for (const field of fields) {\n    expectedFields++;\n\n    const index = documentLines.findIndex(line => {\n      const label = getLabel(line);\n      return label && label.name === field.name;\n    });\n\n    const fieldId = `${section} / ${field.name}`;\n\n    if (index === -1) {\n      missingFields.push(fieldId);\n      continue;\n    }\n\n    presentFields++;\n\n    const firstLine = getLabel(documentLines[index]).value;\n    const content = [firstLine];\n\n    for (let i = index + 1; i < documentLines.length; i++) {\n      const nextLabel = getLabel(documentLines[i]);\n\n      if (nextLabel && allLabels.has(nextLabel.name)) break;\n\n      content.push(documentLines[i]);\n    }\n\n    const value = normalize(content.join('\\n'));\n\n    const isFilled = value.length > 0\n      && value !== 'non documente'\n      && !/\\[[^\\]]*renseigner[^\\]]*\\]/.test(value);\n\n    if (isFilled) {\n      filledFields++;\n    } else {\n      unfilledFields.push(fieldId);\n    }\n  }\n}\n\nconst expectedStructure = expectedSections.length + expectedFields;\nconst presentStructure = expectedSections.length\n  - missingSections.length + presentFields;\n\nreturn {\n  json: {\n    ...$json,\n    quality: {\n      structure_score: expectedStructure\n        ? Math.round(100 * presentStructure / expectedStructure)\n        : 0,\n      completeness_score: expectedFields\n        ? Math.round(100 * filledFields / expectedFields)\n        : 0,\n      sections_expected: expectedSections.length,\n      sections_missing: missingSections,\n      fields_expected: expectedFields,\n      fields_present: presentFields,\n      fields_filled: filledFields,\n      fields_missing: missingFields,\n      fields_unfilled: unfilledFields\n    }\n  }\n};\n"
      },
