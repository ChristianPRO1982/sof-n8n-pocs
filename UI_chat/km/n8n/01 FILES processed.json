{
  "name": "01 FILES processed",
  "nodes": [
    {
      "parameters": {
        "command": "=node <<'JS'\nconst fs = require('node:fs');\nconst path = require('node:path');\n\nconst baseDirectory = '/files/km';\nconst folders = [\n  '01_processed_files',\n  '01_legacy_processed_files'\n];\n\nconst files = folders.flatMap(folder => {\n  const directory = path.join(baseDirectory, folder);\n\n  return fs.readdirSync(directory, { withFileTypes: true })\n    .filter(entry => entry.isFile())\n    .map(entry => {\n      const stat = fs.statSync(path.join(directory, entry.name), {\n        bigint: true\n      });\n\n      const size = Number(stat.size);\n\n      if (!Number.isSafeInteger(size) || size < 0) {\n        throw new Error(\n          `Taille non représentable : ${folder}/${entry.name}`\n        );\n      }\n\n      return {\n        folder,\n        name: entry.name,\n        size,\n        revision: [\n          stat.dev,\n          stat.ino,\n          stat.size,\n          stat.mtimeNs,\n          stat.ctimeNs\n        ].join(':')\n      };\n    });\n});\n\nfiles.sort((a, b) => {\n  if (a.folder !== b.folder) {\n    return a.folder < b.folder ? -1 : 1;\n  }\n\n  return a.name < b.name ? -1 : a.name > b.name ? 1 : 0;\n});\n\nprocess.stdout.write(JSON.stringify(files));\nJS"
      },
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        -1120,
        -448
      ],
      "id": "5a763d8a-c059-48f0-aaf4-82b9e6fb1d76",
      "name": "CMD $ls"
    },
    {
      "parameters": {
        "jsCode": "const { exitCode, stderr, stdout } = $input.first().json;\n\nconst allowedFolders = new Set([\n  '01_processed_files',\n  '01_legacy_processed_files'\n]);\n\ntry {\n  if (exitCode !== 0) {\n    throw new Error(\n      stderr?.trim() || 'Impossible de lire les dossiers.'\n    );\n  }\n\n  const files = JSON.parse(stdout);\n\n  if (!Array.isArray(files)) {\n    throw new Error(\n      'La réponse doit contenir une liste de fichiers.'\n    );\n  }\n\n  const identities = new Set();\n\n  for (const file of files) {\n    if (\n      !file ||\n      !allowedFolders.has(file.folder) ||\n      typeof file.name !== 'string' ||\n      file.name.length === 0 ||\n      !Number.isSafeInteger(file.size) ||\n      file.size < 0 ||\n      typeof file.revision !== 'string' ||\n      file.revision.length === 0\n    ) {\n      throw new Error('Liste de fichiers invalide.');\n    }\n\n    const identity = JSON.stringify([file.folder, file.name]);\n\n    if (identities.has(identity)) {\n      throw new Error(\n        `Fichier en double : ${file.folder}/${file.name}`\n      );\n    }\n\n    identities.add(identity);\n  }\n\n  return [{ json: { ok: true, files } }];\n} catch (error) {\n  return [{\n    json: {\n      ok: false,\n      message: error.message\n    }\n  }];\n}"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
