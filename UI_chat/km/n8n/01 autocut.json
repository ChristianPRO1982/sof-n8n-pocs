      "parameters": {
        "jsCode": "\nconst contents = $input.all();\n\nconst text = contents.map((item, index) => {\n  const file = $('Replace Me').all(0, index)[0];\n\n  return [\n    `# TEMPLATE : ${file.json.fileName}`,\n    '',\n    item.json.data\n  ].join('\\n');\n}).join('\\n\\n---\\n\\n');\n\nreturn [\n  {\n    json: {\n      text\n    }\n  }\n];\n"
