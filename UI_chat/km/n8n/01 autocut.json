    {
      "parameters": {
        "command": "=node <<'JS'\nconst fs = require('node:fs');\nconst path = require('node:path');\n\nconst directory = '/files/km/00_templates';\n\nconst files = fs.readdirSync(directory, { withFileTypes: true })\n  .filter(entry => entry.isFile())\n  .map(entry => {\n    const stat = fs.statSync(path.join(directory, entry.name), {\n      bigint: true\n    });\n\n    const size = Number(stat.size);\n\n    if (!Number.isSafeInteger(size)) {\n      throw new Error(`Taille non représentable : ${entry.name}`);\n    }\n\n    return {\n      name: entry.name,\n      size,\n      revision: [\n        stat.dev,\n        stat.ino,\n        stat.size,\n        stat.mtimeNs,\n        stat.ctimeNs\n      ].join(':')\n    };\n  })\n  .sort((a, b) => a.name < b.name ? -1 : a.name > b.name ? 1 : 0);\n\nprocess.stdout.write(JSON.stringify(files));\nJS"
      },
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        832,
        -2272
      ],
      "id": "390800af-3ad1-402e-aae8-c91d663fe281",
      "name": "LS templates"
    },
    {
      "parameters": {
        "jsCode": "\nconst files = JSON.parse($input.first().json.stdout);\n\nreturn files\n  .filter(file => file.name.toLowerCase().endsWith('.md'))\n  .map(file => ({\n    json: {\n      fileName: file.name,\n      size: file.size\n    }\n  }));\n"
      },
