      "id": "678e4f9f-a592-40b6-b03f-57eafb2e720a",
      "name": "CMD $ls1"
    },
    {
      "parameters": {
        "jsCode": "\nconst files = JSON.parse($input.first().json.stdout);\n\nconst existingFiles = new Set(\n  files.map(file => file.name.toLowerCase())\n);\n\nreturn files\n  .filter(file => {\n    if (!file.name.toLowerCase().endsWith('.pdf')) {\n      return false;\n    }\n\n    const pdfName = file.name.toLowerCase();\n    const mdName = pdfName.replace(/\\.pdf$/, '.md');\n\n    return !existingFiles.has(mdName)\n      && !existingFiles.has(pdfName + '.md');\n  })\n  .map(file => ({\n    json: {\n      fileName: file.name,\n      size: file.size\n    }\n  }));\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
